        <mxCell id="title_box" value="&lt;b style=&quot;font-size: 20px;&quot;&gt;DIAGRAM KONTEKS (DATA FLOW DIAGRAM LEVEL 0)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 13px; color: #64748B;&quot;&gt;Sistem Informasi Pelaporan Pencemaran Sungai (SIPEPES) — MuSilaban (Tim 3)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1.5;align=center;verticalAlign=middle;" vertex="1" parent="1">
