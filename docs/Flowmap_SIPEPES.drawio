<mxfile host="app.diagrams.net">
  <diagram name="Flowmap-SIPEPES" id="flowmap_sipepes">
    <mxGraphModel dx="1800" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1400" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title Banner -->
        <mxCell id="title_box" value="&lt;b style=&quot;font-size: 20px;&quot;&gt;FLOWMAP ALUR SISTEM YANG DIUSULKAN (SIPEPES)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 13px; color: #64748B;&quot;&gt;Sistem Informasi Pelaporan Pencemaran Sungai (SIPEPES) — MuSilaban (Tim 3)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1.5;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="500" y="30" width="920" height="60" as="geometry" />
        </mxCell>

        <!-- Swimlane 1: Warga / Pelapor -->
        <mxCell id="lane_warga" value="&lt;b style=&quot;font-size: 15px;&quot;&gt;WARGA / PELAPOR&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 11px;&quot;&gt;(Masyarakat &amp; Volunteer Lapangan)&lt;/span&gt;" style="swimlane;startSize=50;fillColor=#F0FDF4;strokeColor=#16A34A;strokeWidth=2;align=center;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="60" y="110" width="410" height="1220" as="geometry" />
        </mxCell>
        <mxCell id="w_start" value="Mulai" style="ellipse;whiteSpace=wrap;html=1;fillColor=#16A34A;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;" vertex="1" parent="lane_warga">
          <mxGeometry x="155" y="70" width="100" height="35" as="geometry" />
        </mxCell>
        <mxCell id="w_step1" value="Temukan Titik Pencemaran Sungai&lt;br&gt;dan Buka Portal Web SIPEPES" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#16A34A;strokeWidth=1.5;" vertex="1" parent="lane_warga">
          <mxGeometry x="85" y="130" width="240" height="50" as="geometry" />
        </mxCell>
        <mxCell id="w_step2" value="Input Formulir Pelaporan:&lt;br&gt;• Judul &amp; Deskripsi Kejadian&lt;br&gt;• Titik Koordinat (GPS / Peta)&lt;br&gt;• Foto Bukti &amp; Tingkat Dugaan" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#16A34A;strokeWidth=1.5;align=left;spacingLeft=10;" vertex="1" parent="lane_warga">
          <mxGeometry x="85" y="210" width="240" height="70" as="geometry" />
        </mxCell>
        <mxCell id="w_doc_form" value="Formulir Laporan &amp;&lt;br&gt;Berkas Foto Bukti" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#FEF9C3;strokeColor=#CA8A04;strokeWidth=1.5;" vertex="1" parent="lane_warga">
          <mxGeometry x="115" y="310" width="180" height="55" as="geometry" />
        </mxCell>
        <mxCell id="w_doc_ticket" value="Tanda Terima Tiket&lt;br&gt;&lt;b&gt;SPP-YYYYMM-XXXX&lt;/b&gt;" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#FEF9C3;strokeColor=#CA8A04;strokeWidth=1.5;" vertex="1" parent="lane_warga">
          <mxGeometry x="105" y="440" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="w_step3" value="Memantau Status Tiket atau&lt;br&gt;Melihat Peta Sebaran Publik" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#16A34A;strokeWidth=1.5;" vertex="1" parent="lane_warga">
          <mxGeometry x="85" y="530" width="240" height="50" as="geometry" />
        </mxCell>
        <mxCell id="w_end" value="Selesai" style="ellipse;whiteSpace=wrap;html=1;fillColor=#DC2626;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;" vertex="1" parent="lane_warga">
          <mxGeometry x="155" y="620" width="100" height="35" as="geometry" />
        </mxCell>

        <!-- Swimlane 2: Sistem Web SIPEPES -->
        <mxCell id="lane_system" value="&lt;b style=&quot;font-size: 15px;&quot;&gt;SISTEM WEB SIPEPES&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 11px;&quot;&gt;(Frontend &amp; RESTful API Backend)&lt;/span&gt;" style="swimlane;startSize=50;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=2;align=center;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="490" y="110" width="430" height="1220" as="geometry" />
        </mxCell>
        <mxCell id="s_step_auth" value="Validasi Kredensial (bcrypt)&lt;br&gt;&amp; Terbitkan JWT Session" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2563EB;strokeWidth=1.5;" vertex="1" parent="lane_system">
          <mxGeometry x="95" y="80" width="240" height="50" as="geometry" />
        </mxCell>
        <mxCell id="s_step_upload" value="Proses Data Laporan:&lt;br&gt;1. Validasi Input &amp; MIME type&lt;br&gt;2. Kompresi Foto Otomatis (&amp;le;2MB)&lt;br&gt;3. Generate Tracking Code Unik" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2563EB;strokeWidth=1.5;align=left;spacingLeft=10;" vertex="1" parent="lane_system">
          <mxGeometry x="85" y="300" width="260" height="75" as="geometry" />
        </mxCell>
        <mxCell id="s_step_verify" value="Proses Keputusan Verifikasi:&lt;br&gt;1. UPDATE status tabel reports&lt;br&gt;2. INSERT verification_logs&lt;br&gt;3. Broadcast Event Realtime" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2563EB;strokeWidth=1.5;align=left;spacingLeft=10;" vertex="1" parent="lane_system">
          <mxGeometry x="85" y="560" width="260" height="75" as="geometry" />
        </mxCell>
        <mxCell id="s_step_map" value="Pembaruan Peta Sebaran Publik:&lt;br&gt;• Marker Valid Tampil Realtime&lt;br&gt;• Warna Sesuai Tingkat Dugaan&lt;br&gt;• Pop-up Detail Foto Kejadian" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FDFA;strokeColor=#0D9488;strokeWidth=1.5;align=left;spacingLeft=10;" vertex="1" parent="lane_system">
          <mxGeometry x="85" y="670" width="260" height="70" as="geometry" />
        </mxCell>
        <mxCell id="s_step_export" value="Generate Rekapitulasi Data:&lt;br&gt;• Dokumen PDF (Laporan Eksekutif)&lt;br&gt;• Berkas Excel / CSV (Data Mentah)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2563EB;strokeWidth=1.5;align=left;spacingLeft=10;" vertex="1" parent="lane_system">
          <mxGeometry x="85" y="820" width="260" height="60" as="geometry" />
        </mxCell>

        <!-- Swimlane 3: Storage & Database -->
        <mxCell id="lane_db" value="&lt;b style=&quot;font-size: 15px;&quot;&gt;STORAGE &amp; DATABASE&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 11px;&quot;&gt;(Supabase PostgreSQL &amp; Bucket)&lt;/span&gt;" style="swimlane;startSize=50;fillColor=#FAF5FF;strokeColor=#9333EA;strokeWidth=2;align=center;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="940" y="110" width="410" height="1220" as="geometry" />
        </mxCell>
        <mxCell id="db_users" value="Tabel: users&lt;br&gt;&lt;span style=&quot;font-size: 10px; color: #64748B;&quot;&gt;(Akun Admin Terdaftar)&lt;/span&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#F3E8FF;strokeColor=#9333EA;strokeWidth=1.5;" vertex="1" parent="lane_db">
          <mxGeometry x="115" y="70" width="180" height="65" as="geometry" />
        </mxCell>
        <mxCell id="db_storage" value="Cloud Storage Bucket&lt;br&gt;&lt;span style=&quot;font-size: 10px; color: #64748B;&quot;&gt;(Foto Bukti Kejadian &amp;lt; 2MB)&lt;/span&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#F3E8FF;strokeColor=#9333EA;strokeWidth=1.5;" vertex="1" parent="lane_db">
          <mxGeometry x="110" y="270" width="190" height="65" as="geometry" />
        </mxCell>
        <mxCell id="db_reports" value="Tabel: reports&lt;br&gt;&lt;span style=&quot;font-size: 10px; color: #64748B;&quot;&gt;(status: menunggu/valid/ditolak)&lt;/span&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#F3E8FF;strokeColor=#9333EA;strokeWidth=1.5;" vertex="1" parent="lane_db">
          <mxGeometry x="110" y="370" width="190" height="70" as="geometry" />
        </mxCell>
        <mxCell id="db_logs" value="Tabel: verification_logs&lt;br&gt;&lt;span style=&quot;font-size: 10px; color: #64748B;&quot;&gt;(Audit Trail Verifikasi Admin)&lt;/span&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#F3E8FF;strokeColor=#9333EA;strokeWidth=1.5;" vertex="1" parent="lane_db">
          <mxGeometry x="110" y="565" width="190" height="65" as="geometry" />
        </mxCell>

        <!-- Swimlane 4: Admin Komunitas -->
        <mxCell id="lane_admin" value="&lt;b style=&quot;font-size: 15px;&quot;&gt;ADMIN KOMUNITAS&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 11px;&quot;&gt;(Green Generation - Divisi PKL)&lt;/span&gt;" style="swimlane;startSize=50;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=2;align=center;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="1370" y="110" width="410" height="1220" as="geometry" />
        </mxCell>
        <mxCell id="a_step_login" value="Buka Dashboard Admin&lt;br&gt;&amp; Input Kredensial Login" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D97706;strokeWidth=1.5;" vertex="1" parent="lane_admin">
          <mxGeometry x="85" y="80" width="240" height="50" as="geometry" />
        </mxCell>
        <mxCell id="a_step_review" value="Tinjau Laporan Menunggu:&lt;br&gt;• Cek Deskripsi &amp; Lokasi di Peta&lt;br&gt;• Cek Foto Resolusi Penuh&lt;br&gt;• Evaluasi Tingkat Dugaan" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D97706;strokeWidth=1.5;align=left;spacingLeft=10;" vertex="1" parent="lane_admin">
          <mxGeometry x="85" y="210" width="240" height="70" as="geometry" />
        </mxCell>
        <mxCell id="a_decision" value="Laporan&lt;br&gt;Sesuai / Valid?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=2;fontStyle=1;" vertex="1" parent="lane_admin">
          <mxGeometry x="125" y="320" width="160" height="80" as="geometry" />
        </mxCell>
        <mxCell id="a_reject" value="Input Alasan Penolakan&lt;br&gt;&amp; Klik 'Tolak Laporan'" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#DC2626;strokeWidth=1.5;" vertex="1" parent="lane_admin">
          <mxGeometry x="85" y="440" width="240" height="50" as="geometry" />
        </mxCell>
        <mxCell id="a_approve" value="Konfirmasi Tingkat Dugaan&lt;br&gt;&amp; Klik 'Validasi Laporan'" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#16A34A;strokeWidth=1.5;" vertex="1" parent="lane_admin">
          <mxGeometry x="85" y="530" width="240" height="50" as="geometry" />
        </mxCell>
        <mxCell id="a_export" value="Pilih Rentang Periode &amp;&lt;br&gt;Klik 'Ekspor Rekap Laporan'" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D97706;strokeWidth=1.5;" vertex="1" parent="lane_admin">
          <mxGeometry x="85" y="820" width="240" height="50" as="geometry" />
        </mxCell>
        <mxCell id="a_doc_export" value="Berkas Rekapitulasi Advokasi&lt;br&gt;(PDF &amp; Excel/CSV)" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#FEF9C3;strokeColor=#CA8A04;strokeWidth=1.5;" vertex="1" parent="lane_admin">
          <mxGeometry x="105" y="910" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="a_step_advocacy" value="Penyampaian Bahan Advokasi&lt;br&gt;ke DLH / Instansi Pemerintah" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D97706;strokeWidth=1.5;" vertex="1" parent="lane_admin">
          <mxGeometry x="85" y="1000" width="240" height="50" as="geometry" />
        </mxCell>
        <mxCell id="a_end" value="Selesai" style="ellipse;whiteSpace=wrap;html=1;fillColor=#DC2626;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;" vertex="1" parent="lane_admin">
          <mxGeometry x="155" y="1080" width="100" height="35" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
